{
  "name": "caught-up",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "test": "node --test",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "lint-staged": "lint-staged"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "eslint": "^9.26.0",
    "globals": "^16.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.0.0",
    "prettier": "^3.5.3",
    "typescript-eslint": "^8.31.0"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,ts,tsx}": "eslint --max-warnings=0",
    "*.{css,json,md,yml,yaml}": "prettier --check"
  }
}
